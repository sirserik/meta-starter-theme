{
    "name": "sirserik/starter-theme",
    "description": "Twenty-Twenty-Four-style starter theme for meta/admin-core sites. Layouts, header/footer/modals, error pages, design tokens, Tailwind preset.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        { "name": "META University", "email": "dev@meta.edu.kz" }
    ],
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0|^12.0",
        "sirserik/admin-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Meta\\StarterTheme\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Meta\\StarterTheme\\ThemeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
